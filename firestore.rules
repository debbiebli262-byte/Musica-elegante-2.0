rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog, editable only by the verified library administrator.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'debbiebli262@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /artists/{artistId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /albums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // This app uses userId='public' for its shared collection.
    match /collection/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
