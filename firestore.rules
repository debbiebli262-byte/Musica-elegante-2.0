rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Both named accounts have identical rights. Nobody else can read or edit.
    function isAllowedMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'debbiebli262@gmail.com',
          'javierblinder@yahoo.com.ar'
        ];
    }

    match /artists/{artistId} {
      allow read, write: if isAllowedMember();
    }
    match /albums/{albumId} {
      allow read, write: if isAllowedMember();
    }
    match /import_jobs/{jobId} {
      allow read, write: if isAllowedMember();
    }
    // Both members share one collection; no admin role.
    match /collection/{itemId} {
      allow read, write: if isAllowedMember();
    }
  }
}
